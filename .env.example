# Copy this file to ".env" and fill in real values before deploying.

# First-run admin login (only used once, to create the admin account).
# After the account is created in data/db.json, changing these does nothing —
# change the password from inside the admin panel instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random long string used to sign session cookies. Any long random text works.
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on (Railway/most hosts set this automatically)
PORT=3000
